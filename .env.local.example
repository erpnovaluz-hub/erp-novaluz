# Copie para .env.local e preencha com as chaves do seu projeto Supabase
# (Supabase Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Só para o Administrador Central criar usuários (server-side, NUNCA exposto ao browser).
# É a chave "service_role" em Project Settings > API. No Vercel, adicione como variável de ambiente.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key
